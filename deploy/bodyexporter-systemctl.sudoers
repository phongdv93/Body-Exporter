# Passwordless systemctl for GitHub Actions deploy user (non-interactive SSH).
# Install once on VPS as root:
#   DEPLOY_USER=your_github_actions_ssh_user
#   sed "s/DEPLOY_USER/$DEPLOY_USER/" /var/www/bodyexporter.com/deploy/bodyexporter-systemctl.sudoers \
#     > /etc/sudoers.d/bodyexporter-deploy
#   chmod 440 /etc/sudoers.d/bodyexporter-deploy
#   visudo -c
#
# Or run: sudo bash deploy/setup-deploy-sudo.sh DEPLOY_USER

DEPLOY_USER ALL=(root) NOPASSWD: /bin/systemctl restart bodyexporter
DEPLOY_USER ALL=(root) NOPASSWD: /bin/systemctl is-active bodyexporter
DEPLOY_USER ALL=(root) NOPASSWD: /bin/systemctl status bodyexporter
DEPLOY_USER ALL=(root) NOPASSWD: /bin/systemctl status bodyexporter --no-pager
DEPLOY_USER ALL=(root) NOPASSWD: /bin/systemctl status bodyexporter --no-pager -l
DEPLOY_USER ALL=(root) NOPASSWD: /usr/bin/journalctl -u bodyexporter -n 80 --no-pager
DEPLOY_USER ALL=(root) NOPASSWD: /bin/chown -R www-data\:www-data /var/www/bodyexporter.com/website/uploads
DEPLOY_USER ALL=(root) NOPASSWD: /bin/chmod -R u+rwX\,g+rwX /var/www/bodyexporter.com/website/uploads
