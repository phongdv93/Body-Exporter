# Copy to .env and fill in. Never commit .env.

# Required: random string for session cookies
SECRET_KEY=change-me-to-long-random-string

# Admin login (dashboard at /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public site URL (for redirects, SePay callbacks)
SITE_URL=https://bodyexporter.com

# Database (production): PostgreSQL — same pattern as nesting.click on Railway/Render/Fly + Neon/Supabase
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Railway/Heroku often gives postgres:// — that works (we normalize automatically).
# Add ?sslmode=require if your host requires SSL (Neon, Supabase cloud).
DATABASE_URL=

# Support / from addresses (Resend + Cloudflare Email Routing)
SUPPORT_EMAIL=hotro@bodyexporter.com
# RESEND_API_KEY=
# RESEND_FROM=Body Exporter <noreply@bodyexporter.com>
# RESEND_LICENSE_TEMPLATE_ID_VI=   # Published VI template (VietQR / SePay)
# RESEND_LICENSE_TEMPLATE_ID_EN=   # Published EN template (Paddle)
# RESEND_LICENSE_TEMPLATE_ID=      # Legacy fallback if _VI unset
# RESEND_LICENSE_SUBJECT_VI=License key Body Exporter — SolidWorks
# RESEND_LICENSE_SUBJECT_EN=Your Body Exporter license key — SolidWorks

# Cloudflare Worker — required for UUID keys that validate in the add-in (POST /admin/license/issue)
# Must include https:// (Render env without protocol will be auto-fixed on deploy)
# WORKER_API_BASE_URL=https://bodyexporter-api.bodyexporter.workers.dev
# WORKER_ADMIN_TOKEN=

# Public /buy: VietQR + SePay card checkout (Vietnam). false = Paddle only on /buy.
# SEPAY_PUBLIC_ENABLED=true
# Must match the security mode on SePay (HMAC-SHA256 → secret, or API Key → Apikey header).
SEPAY_WEBHOOK_SECRET=
# SEPAY_WEBHOOK_API_KEY=
# SEPAY_LEGACY_AMOUNTS_VND=990000

SEPAY_QR_BASE_URL=https://qr.sepay.vn/img?bank=ACB&acc=4518527&amount=1590000&des=Body%20Export%20License
# VietQR discount codes (CODE:percent). Also editable in Admin → Nội dung.
# VN_DISCOUNT_CODES=TESTRUN:99,FRIEND20:20
LICENSE_PRICE_VND=1590000
# Optional: USD shown on /buy for Paddle (else VND / USD_VND_RATE)
# LICENSE_PRICE_USD=65
# USD_VND_RATE=25000

# Paddle Billing (international /buy — overlay checkout)
# PADDLE_CLIENT_TOKEN=test_...
# PADDLE_PRICE_ID=pri_...
# PADDLE_WEBHOOK_SECRET=...
# PADDLE_ENV=sandbox
# Webhook URL in Paddle dashboard: SITE_URL/webhook/paddle

# Optional: SePay Payment Gateway (card + VietQR on pay.sepay.vn)
# SEPAY_PG_MERCHANT_ID=
# SEPAY_PG_SECRET_KEY=
# SEPAY_PG_ENV=sandbox

# Optional: override default SEO copy
SEO_DESCRIPTION=Body Exporter — add-in SolidWorks...
SEO_KEYWORDS=SolidWorks, add-in, Body Exporter, body export, BOM export, part export, xuat body, xuat BOM, xuat BOM tu SolidWorks, xuat danh sach chi tiet tu SolidWorks, xuất BOM từ SolidWorks, xuất danh sách chi tiết từ SolidWorks, xuất body từ SolidWorks, Excel, license
# SEO_KEYWORDS_EN=SolidWorks, add-in, Body Exporter, body export, BOM export, export body, export BOM, export part list, export detail list, Excel, license
# SEO_OG_IMAGE=https://bodyexporter.com/static/og-card.png
