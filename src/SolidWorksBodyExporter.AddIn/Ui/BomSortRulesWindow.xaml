<Window x:Class="SolidWorksBodyExporter.AddIn.Ui.BomSortRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOM sort keywords"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#EEF1F7"
        FontFamily="Segoe UI, Tahoma, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF58B7FF" Offset="0" />
            <GradientStop Color="#FFBA56FF" Offset="1" />
        </LinearGradientBrush>

        <ControlTemplate x:Key="GradientButtonTemplate" TargetType="Button">
            <Border x:Name="GradientBtnBorder" CornerRadius="6"
                    Background="{TemplateBinding Background}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="GradientBtnBorder" Property="Opacity" Value="0.86" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
            <Setter Property="Template" Value="{StaticResource GradientButtonTemplate}" />
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Foreground" Value="#FF334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFF0F2F5" />
            <Setter Property="BorderBrush" Value="#FFD1D9E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF1E293B" />
        </Style>

        <Style TargetType="DataGrid" x:Key="RulesGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE2E8F0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD0D8E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF8FAFC" />
            <Setter Property="Foreground" Value="#FF64748B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource SectionTitle}"
                   Text="Production BOM order" />
        <TextBlock Grid.Row="1"
                   Margin="0,4,0,12"
                   TextWrapping="Wrap"
                   Foreground="#FF64748B"
                   FontSize="12"
                   Text="Lower priority numbers sort first. Keywords match body / display names (accents optional). Separate keywords with commas or new lines." />

        <Border Grid.Row="2"
                CornerRadius="8"
                Background="White"
                BorderBrush="#FFD0D8E8"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="14" ShadowDepth="2" Opacity="0.08" />
            </Border.Effect>
            <DataGrid x:Name="TiersGrid"
                      Style="{StaticResource RulesGrid}"
                      ItemsSource="{Binding Tiers}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Priority"
                                        Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                                        Width="72" />
                    <DataGridTextColumn Header="Group label"
                                        Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                        Width="140" />
                    <DataGridTextColumn Header="Keywords"
                                        Binding="{Binding KeywordsText, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Add tier"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Click="AddTier_Click" />
            <Button Grid.Column="1"
                    Content="Remove tier"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Click="RemoveTier_Click" />
            <Button Grid.Column="3"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Grid.Column="4"
                    Content="Save"
                    Style="{StaticResource PrimaryButton}"
                    Width="96"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
