<Window x:Class="SolidWorksBodyExporter.AddIn.Ui.BomTypeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOM type settings"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EEF1F7"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Margin="16" Padding="16" Background="White" CornerRadius="8" BorderBrush="#FFE2E8F0" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Khác (Other)" FontSize="16" FontWeight="SemiBold" Foreground="#FF1E293B" Margin="0,0,0,6" />
            <TextBlock TextWrapping="Wrap" Foreground="#FF64748B" FontSize="12" Margin="0,0,0,14"
                       Text="Rows marked Khác are skipped for Excel and ERP by default. Enable below to include them." />

            <CheckBox x:Name="ExcelCheck" Margin="0,0,0,10" FontSize="13"
                      Content="Include Khác when exporting Excel" />
            <CheckBox x:Name="ErpCheck" Margin="0,0,0,16" FontSize="13"
                      Content="Include Khác when sending to ERP" />

            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Save" Width="88" Height="32" Margin="8,0,0,0"
                        Click="Save_Click" IsDefault="True"
                        Background="#FF3B82F6" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                <Button DockPanel.Dock="Right" Content="Cancel" Width="88" Height="32"
                        IsCancel="True" Click="Cancel_Click" Cursor="Hand" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
