<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <!--
    Standalone launcher executable. Built as a Windows desktop exe (WPF), NOT a COM addin.

    Rationale: SolidWorks 2024's CommandManager ribbon paint loop refuses to honour our enable
    callback's "1 = enabled" return value after the very first paint cycle, regardless of how
    frequently we poll, re-invalidate, or rewrite Tab Props in the registry. We diagnosed this
    over ~15 build cycles and proved the callback fires hundreds of times per minute with the
    correct return value, yet the icon renders greyed out. The greying is purely cosmetic at
    the SolidWorks UI layer and outside our control.

    The launcher fixes that by sidestepping SolidWorks' ribbon entirely:
      1. User pins SolidWorksBodyExporter.Launcher.exe to the taskbar / Start Menu / desktop.
      2. On click, the launcher uses COM running-object-table lookup (Marshal.GetActiveObject)
         to attach to the already-running SolidWorks process.
      3. It grabs the active ModelDoc2 and opens the exact same BodyExportWindow the in-process
         add-in would, with the same license / scanner / metadata pipeline.

    The in-process add-in still ships and still registers the CommandGroup, so users on
    SolidWorks builds where the ribbon happens to render correctly can keep clicking the icon.
    But the launcher is the documented, guaranteed entry point.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SolidWorksBodyExporter.Launcher</RootNamespace>
    <AssemblyName>SolidWorksBodyExporter.Launcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>SolidWorksBodyExporter.Launcher.App</StartupObject>
    <Version>0.7.3.0</Version>
    <AssemblyVersion>0.7.3.0</AssemblyVersion>
    <FileVersion>0.7.3.0</FileVersion>
    <!-- Embed the multi-resolution .ico into the EXE so Windows shows the BodyExporter
         square in the taskbar, Start menu, file explorer, and any shortcut to this EXE.
         The .ico is generated by tools\Build-LauncherIco.ps1 from the procedural PNGs
         that AddInIcons emits, so the launcher icon stays in lock-step with the in-SW
         ribbon icon design. -->
    <ApplicationIcon>..\..\assets\BodyExporter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The launcher pulls the addin project ONLY to share the IpcServer.GetPipeName() helper,
         which guarantees launcher and addin agree on the pipe name without having to duplicate
         the user-SID derivation logic. The launcher no longer references SolidWorks.Interop.*
         because all SolidWorks interaction happens inside the addin (which is loaded by SW). -->
    <ProjectReference Include="..\SolidWorksBodyExporter.AddIn\SolidWorksBodyExporter.AddIn.csproj" />
  </ItemGroup>
</Project>
